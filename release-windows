#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="${ROOT}/build-release-windows"
TOOLCHAIN="${ROOT}/toolchain-mingw.cmake"

cmake -S "$ROOT" -B "$BUILD_DIR" -G Ninja \
    -DCMAKE_TOOLCHAIN_FILE="$TOOLCHAIN" \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DSFML_BUILD_SHARED_LIBS=OFF \
    -DBLOCKBIT_WITH_GNS=OFF \
    -DCMAKE_EXE_LINKER_FLAGS="-static -static-libgcc -static-libstdc++"
cmake --build "$BUILD_DIR" --parallel "${JOBS:-$(nproc)}"

mkdir -p "$ROOT/release/windows"
cp "$BUILD_DIR/bin/Blockbit.exe" "$ROOT/release/windows/Blockbit.exe"
cp "$BUILD_DIR/bin/BlockbitServer.exe" "$ROOT/release/windows/BlockbitServer.exe"
echo "Windows release binaries: $ROOT/release/windows"
